--- a/third-part/hev-task-system/src/mem/base/hev-memory-allocator.c
+++ b/third-part/hev-task-system/src/mem/base/hev-memory-allocator.c
@@ -7,6 +7,7 @@
  ============================================================================
  */
 
+#include <malloc.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -17,6 +18,55 @@
 
 static __thread HevMemoryAllocator *tls_default_allocator;
 
+static size_t memory_usage;
+
+static size_t
+usable_size (void *ptr)
+{
+    return ptr ? malloc_usable_size (ptr) : 0;
+}
+
+void *
+hev_memory_tracked_malloc (size_t size)
+{
+    void *ptr;
+
+    ptr = malloc (size);
+    if (ptr)
+        __atomic_fetch_add (&memory_usage, usable_size (ptr), __ATOMIC_RELAXED);
+    return ptr;
+}
+
+void *
+hev_memory_tracked_realloc (void *ptr, size_t size)
+{
+    size_t old_size = usable_size (ptr);
+    void *new_ptr;
+
+    new_ptr = realloc (ptr, size);
+    if (new_ptr) {
+        __atomic_fetch_sub (&memory_usage, old_size, __ATOMIC_RELAXED);
+        __atomic_fetch_add (&memory_usage, usable_size (new_ptr),
+                            __ATOMIC_RELAXED);
+    }
+    return new_ptr;
+}
+
+void
+hev_memory_tracked_free (void *ptr)
+{
+    if (!ptr)
+        return;
+    __atomic_fetch_sub (&memory_usage, usable_size (ptr), __ATOMIC_RELAXED);
+    free (ptr);
+}
+
+size_t
+hev_memory_usage (void)
+{
+    return __atomic_load_n (&memory_usage, __ATOMIC_RELAXED);
+}
+
 HevMemoryAllocator *
 hev_memory_allocator_default (void)
 {
